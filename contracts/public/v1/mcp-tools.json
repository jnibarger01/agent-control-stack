{
  "schemaVersion": "acs.gateway-mcp.1.0.0",
  "protocolVersion": "2024-11-05",
  "tools": [
    {
      "name": "create_work_item",
      "exposure": "remote",
      "description": "Create a governed work item and immediately evaluate it through the policy gate.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "requester": {
            "type": "string",
            "enum": [
              "user",
              "agent",
              "system"
            ]
          },
          "requesterSubject": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "default": "pending_policy",
            "type": "string",
            "enum": [
              "draft",
              "pending_policy"
            ]
          },
          "intent": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "default": {},
            "type": "object",
            "properties": {
              "repo": {
                "type": "string",
                "minLength": 1
              },
              "cwd": {
                "type": "string",
                "minLength": 1
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "services": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "requestedActions": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "params": {
                  "default": {},
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "kind",
                "description"
              ]
            }
          },
          "risk": {
            "default": "medium",
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "metadata": {
            "type": "object",
            "properties": {
              "webhookSource": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9_-]{1,64}$"
              },
              "correlationId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "title",
          "requester",
          "intent"
        ]
      },
      "requiredScopes": [
        "acs:work:create"
      ],
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "get_work_item",
      "exposure": "remote",
      "description": "Read one work item by id.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id"
        ]
      },
      "requiredScopes": [
        "acs:work:read"
      ],
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "list_work_items",
      "exposure": "remote",
      "description": "List work items, optionally filtered by status. Page size defaults to 100 and is hard-capped at 500.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "pending_policy",
              "needs_approval",
              "approved",
              "running",
              "cancelling",
              "succeeded",
              "failed",
              "blocked",
              "cancelled",
              "rejected",
              "unknown",
              "quarantined"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          }
        }
      },
      "requiredScopes": [
        "acs:work:read"
      ],
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "approve_work_item",
      "exposure": "prohibited_over_mcp",
      "description": "Record user approval for the exact policy-evaluated action hash on a work item.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "actionHash": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "reason",
          "actionHash"
        ]
      },
      "requiredScopes": [
        "acs:work:approve"
      ],
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "unblock_work_item",
      "exposure": "remote",
      "description": "Move a blocked work item back to pending policy evaluation.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id"
        ]
      },
      "requiredScopes": [
        "acs:work:approve"
      ],
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "reject_work_item",
      "exposure": "remote",
      "description": "Reject a work item through a distinct terminal denial state.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id"
        ]
      },
      "requiredScopes": [
        "acs:work:approve"
      ],
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "cancel_work_item",
      "exposure": "remote",
      "description": "Cancel a work item through the work-item state machine.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id"
        ]
      },
      "requiredScopes": [
        "acs:work:approve"
      ],
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "explain_policy",
      "exposure": "remote",
      "description": "Read-only policy explain for a candidate action: decision, matched rule ids, and action hash. Does not execute or record.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workItemId": {
            "type": "string",
            "minLength": 1
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "enum": [
              "create",
              "approve",
              "unblock",
              "claim"
            ]
          },
          "requester": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "action": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "params": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "kind",
              "description"
            ]
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "network": {
            "type": "boolean"
          },
          "write": {
            "type": "boolean"
          },
          "destructive": {
            "type": "boolean"
          }
        },
        "required": [
          "workItemId",
          "actor",
          "operation",
          "requester",
          "risk",
          "action"
        ]
      },
      "requiredScopes": [
        "acs:work:read"
      ],
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "open_acs_dashboard",
      "exposure": "remote",
      "description": "Open the read-only ACS Control Center with current health, executions, approvals, and operational findings.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      },
      "requiredScopes": [
        "acs:work:read"
      ],
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "get_execution_detail",
      "exposure": "remote",
      "description": "Read authoritative detail and recent audit events for one ACS execution.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id"
        ]
      },
      "requiredScopes": [
        "acs:work:read"
      ],
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "portfolio.get_summary",
      "exposure": "remote",
      "description": "Read the Visualizer GitHub portfolio summary. This never mutates GitHub.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "requiredScopes": [
        "acs:work:read"
      ],
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "portfolio.list_repositories",
      "exposure": "remote",
      "description": "List persisted GitHub portfolio repositories from Visualizer. This never mutates GitHub.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "HEALTHY",
              "ATTENTION",
              "BLOCKED",
              "UNKNOWN",
              "ARCHIVED"
            ]
          },
          "lifecycle": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "MAINTENANCE",
              "EXPERIMENTAL",
              "DORMANT",
              "ARCHIVED",
              "UNKNOWN"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "additionalProperties": false
      },
      "requiredScopes": [
        "acs:work:read"
      ],
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "portfolio.list_attention_required",
      "exposure": "remote",
      "description": "List ranked GitHub portfolio attention items from Visualizer. This never mutates GitHub.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "additionalProperties": false
      },
      "requiredScopes": [
        "acs:work:read"
      ],
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "portfolio.get_repository",
      "exposure": "remote",
      "description": "Read one persisted GitHub portfolio repository from Visualizer. This never mutates GitHub.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
          }
        },
        "required": [
          "repository"
        ],
        "additionalProperties": false
      },
      "requiredScopes": [
        "acs:work:read"
      ],
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "portfolio.list_failures",
      "exposure": "remote",
