[Unit]
Description=Isolated Jace Commander Bridge with Kernel Witness V2 eBPF Observation
Documentation=file:///opt/acs-runtime/current/ops/jc-kernel-witness/README.md
After=network-online.target acs-core.service jc-witness-signerd.service
Requires=acs-core.service jc-witness-signerd.service

[Service]
Type=simple
User=acs-jc
Group=acs-jc
SupplementaryGroups=jc-witness-signer
WorkingDirectory=/opt/acs-runtime/current/apps/dc-mcp-gateway
EnvironmentFile=/etc/acs-secrets/acs-jc.env
Environment=BRIDGE_PROFILE=jace-commander
Environment=BRIDGE_PORT=8003
Environment=ACS_MANAGED_MODE=1
Environment=JC_WITNESS_ENABLED=1
Environment=JC_WITNESS_REQUIRED=1
Environment=JC_WITNESS_MODE=live
Environment=JC_WITNESS_SCHEMA_VERSION=v2
Environment=JC_WITNESS_BIN=/usr/lib/jace-commander/jc-kernel-witness
Environment=JC_WITNESS_BPF_OBJ=/usr/lib/jace-commander/witness.bpf.o
Environment=JC_WITNESS_SIGNER_SOCKET=/run/jc-witness-signer/sign.sock
Environment=JC_WITNESS_PUBLIC_KEY=/etc/jace-commander/observer.pub.pem
Environment=JC_WITNESS_RECEIPT_DIR=/var/lib/acs-jc/witness-receipts
ExecStart=/usr/bin/node bridge.js
Restart=on-failure
RestartSec=5
UMask=0077

# Delegated cgroup v2 subtree so jc-kernel-witness creates per-invocation leaf cgroups without root
Delegate=yes
DelegateControllers=cpu io memory pids

# Minimum Linux capabilities required ONLY for CO-RE eBPF loading & ringbuf attachment.
# Untrusted workloads run inside bwrap --cap-drop ALL and inherit zero capabilities.
NoNewPrivileges=yes
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_SYS_RESOURCE
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_RESOURCE

PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
StateDirectory=acs-jc
StateDirectoryMode=0700
RuntimeDirectory=jace-commander/witness
RuntimeDirectoryMode=0750
ReadWritePaths=/var/lib/acs-jc /run/jace-commander/witness /sys/fs/cgroup
ReadOnlyPaths=/usr/lib/jace-commander /etc/jace-commander
InaccessiblePaths=/var/lib/jace-commander/witness-signer

[Install]
WantedBy=multi-user.target
