# /etc/acs-secrets/acs-core.env (mode 0600, owned by root:acs-core)
ACS_BLACK_BOX_DB_PATH=/var/lib/acs-core/acs.sqlite
ACS_WITNESS_REQUIRE_LIVE_MODE=1
ACS_WITNESS_REQUIRED_SCOPE=process,filesystem,network

# WORM Sink Provider ("fs" for immutable local/NFS vault, or "s3" for S3 Object Lock COMPLIANCE/GOVERNANCE)
ACS_WORM_SINK_PROVIDER=fs
ACS_WORM_SINK_DIR=/var/lib/acs-core/worm-vault
# For S3 Object Lock:
# ACS_WORM_SINK_PROVIDER=s3
# ACS_WORM_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# ACS_WORM_S3_BUCKET=acs-black-box-worm-prod
# ACS_WORM_S3_REGION=us-east-1
# ACS_WORM_S3_RETENTION_DAYS=365
# ACS_WORM_S3_LOCK_MODE=COMPLIANCE
