# /etc/acs-secrets/jc-witness-signerd.env (mode 0600, owned by root:jc-witness-signer)
JC_WITNESS_SIGNER_SOCKET=/run/jc-witness-signer/sign.sock
JC_WITNESS_SIGNER_STATE_DIR=/var/lib/jace-commander/witness-signer
JC_WITNESS_EXPECTED_OBSERVER_BIN=/usr/lib/jace-commander/jc-kernel-witness
JC_WITNESS_SIGNER_MAX_AGE_NS=30000000000
JC_WITNESS_SIGNER_REQUIRE_DISTINCT_UID=1
