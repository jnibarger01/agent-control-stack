# /etc/acs-secrets/acs-jc.env (mode 0600, owned by root:acs-jc)
# NOTE: Never set JC_WITNESS_SIGNING_KEY here. Private key material stays exclusively inside jc-witness-signerd.
JC_STATE_DIR=/var/lib/acs-jc
JC_ACS_URL=http://127.0.0.1:3000
JC_WITNESS_ENABLED=1
JC_WITNESS_REQUIRED=1
JC_WITNESS_MODE=live
JC_WITNESS_SCHEMA_VERSION=v2
JC_WITNESS_PATH_DISPLAY_MODE=digest
JC_WITNESS_BIN=/usr/lib/jace-commander/jc-kernel-witness
JC_WITNESS_BPF_OBJ=/usr/lib/jace-commander/witness.bpf.o
JC_WITNESS_SIGNER_SOCKET=/run/jc-witness-signer/sign.sock
JC_WITNESS_PUBLIC_KEY=/etc/jace-commander/observer.pub.pem
JC_WITNESS_RECEIPT_DIR=/var/lib/acs-jc/witness-receipts
JC_WITNESS_PATH_HMAC_KEY_FILE=/etc/acs-secrets/witness-path-hmac.key
