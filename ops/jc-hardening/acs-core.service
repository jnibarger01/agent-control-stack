[Unit]
Description=ACS authorization authority
After=network-online.target
[Service]
Type=simple
User=acs-core
Group=acs-core
WorkingDirectory=/opt/acs-runtime/current
EnvironmentFile=/etc/acs-secrets/acs-core.env
ExecStart=/usr/bin/node apps/gateway/dist/cli.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StateDirectory=acs-core
StateDirectoryMode=0700
ReadWritePaths=/var/lib/acs-core
[Install]
WantedBy=multi-user.target
