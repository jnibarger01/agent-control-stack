# Default-deny public ingress for Jace Commander (route allowlist). Canonical unit. Runs as acs-ingress.
# Runs edge/ingress.js (the reviewed, hardened ingress), NOT the earlier public-edge-proxy.js draft.
# Holds NO secrets. Loopback only. Funnel may proxy ONLY to 127.0.0.1:8011, and Funnel stays off until approved.
[Unit]
Description=Default-deny Jace Commander public ingress (loopback)
After=network-online.target acs-jc-edge.service
Wants=acs-jc-edge.service

[Service]
Type=simple
User=acs-ingress
Group=acs-ingress
WorkingDirectory=/opt/acs-runtime/current/apps/dc-mcp-gateway
EnvironmentFile=/etc/acs-secrets/acs-ingress.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/acs-runtime/current/apps/dc-mcp-gateway/edge/ingress.js
ExecStartPre=/usr/bin/test -s /etc/acs-secrets/acs-ingress.env
Restart=on-failure
RestartSec=5

# --- sandbox -------------------------------------------------------------------------------------
StateDirectory=acs-ingress
StateDirectoryMode=0700
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateUsers=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
ReadOnlyPaths=/opt/acs-runtime
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
