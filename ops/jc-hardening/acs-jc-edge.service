[Unit]
Description=Isolated Jace Commander OAuth gateway
After=network-online.target acs-jc-bridge.service
Requires=acs-jc-bridge.service
[Service]
Type=simple
User=acs-edge
Group=acs-edge
WorkingDirectory=/opt/acs-runtime/current/apps/dc-mcp-gateway
EnvironmentFile=/etc/acs-secrets/acs-edge.env
Environment=NODE_ENV=production
Environment=GATEWAY_PORT=8010
Environment=DATA_DIR=/var/lib/acs-edge
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectHome=yes
StateDirectory=acs-edge
StateDirectoryMode=0700
ReadWritePaths=/var/lib/acs-edge
[Install]
WantedBy=multi-user.target
