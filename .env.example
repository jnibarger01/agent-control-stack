# Agent Control Stack environment example.
# Copy to .env for local use. Keep real secrets out of git.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
ACS_DB_PATH=storage/local.db

# `acs serve` runtime topology. The YAML file is optional; environment values win.
ACS_RUNTIME_CONFIG=acs.config.yaml
ACS_RUNTIME_STATUS_PORT=3001
ACS_SCHEDULER_INTERVAL_MS=60000
ACS_WORKER_INTERVAL_MS=5000
ACS_RECONCILE_INTERVAL_MS=30000
ACS_WORKER_ID=local-runtime-worker

# Dashboard/API auth. Leave blank to disable local dashboard auth.
ACS_GATEWAY_TOKEN=
ACS_GATEWAY_ACTOR=user
ACS_GATEWAY_ACTOR_ID=

# MCP auth. Local bearer is ignored when NODE_ENV=production.
ACS_MCP_BEARER_TOKEN=
ACS_MCP_RESOURCE_METADATA_URL=

# Production OAuth/JWKS auth. Set all three together. Remote production
# binding also requires ACS_GATEWAY_TOKEN and either this set or trusted tunnel mode.
ACS_OAUTH_ISSUER=
ACS_OAUTH_AUDIENCE=
ACS_OAUTH_JWKS_URI=

# Trusted tunnel-session mode.
ACS_AUTH_MODE=
ACS_TRUSTED_TUNNEL_PROXY=
ACS_ALLOWED_TUNNEL_IDS=
ACS_TUNNEL_SCOPES=
ACS_ALLOW_UNSIGNED_TUNNEL_ID_DEV=

# Local config paths.
ACS_MCP_CONFIG=
ACS_MACHINE_CONTROLLER_CONFIG=

# Read-only ACP adapter.
ACS_ACP_AGENT_COMMAND=
ACS_ACP_AGENT_ARGS_JSON=[]
ACS_ACP_AGENT_CWD=
ACS_ACP_AGENT_ID=
ACS_ACP_ACTOR_ID=
ACS_ACP_INITIALIZE_TIMEOUT_MS=
ACS_ACP_PROTOCOL_VERSION=

# MoA/model routing.
ACS_MOA_CONFIG=
ACS_MOA_AUDIT_LOG=storage/moa-audit.jsonl
ACS_OPENROUTER_API_KEY=
ACS_OPENROUTER_BASE_URL=
ACS_OPENAI_API_KEY=
ACS_OPENAI_BASE_URL=
ACS_OLLAMA_BASE_URL=http://127.0.0.1:11434
