# Agent Control Stack environment example.
# Copy to .env for local use. Keep real secrets out of git.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
ACS_DB_PATH=storage/local.db

# `acs serve` runtime topology. The YAML file is optional; environment values win.
ACS_RUNTIME_CONFIG=acs.config.yaml
ACS_RUNTIME_STATUS_PORT=3001
ACS_SCHEDULER_INTERVAL_MS=60000
ACS_WORKER_INTERVAL_MS=5000
ACS_RECONCILE_INTERVAL_MS=30000
ACS_WORKER_ID=local-runtime-worker

# Dashboard/API auth. Leave blank to disable local dashboard auth.
ACS_GATEWAY_TOKEN=
ACS_GATEWAY_ACTOR=user
ACS_GATEWAY_ACTOR_ID=

# MCP auth. Local bearer is ignored when NODE_ENV=production.
ACS_MCP_BEARER_TOKEN=
ACS_MCP_RESOURCE_METADATA_URL=
# Optional per-identity MCP tool allowlist (JSON object: identity → tool name array).
# Identity is connectorId when present, otherwise OAuth/local subject.
# Production (NODE_ENV=production): unknown identities are default-denied when configured.
# Local/non-production: permissive default — unknown identities may call any tool; listed
# identities are still restricted to their tool list. Omit or leave empty to disable.
# ACS_MCP_TOOL_ALLOWLIST_JSON={"agent-a":["list_work_items"],"agent-b":["get_work_item","list_work_items"]}

# Production OAuth/JWKS auth. Set all three together. Remote production
# binding also requires ACS_GATEWAY_TOKEN and either this set or trusted tunnel mode.
ACS_OAUTH_ISSUER=
ACS_OAUTH_AUDIENCE=
ACS_OAUTH_JWKS_URI=

# Trusted tunnel-session mode.
ACS_AUTH_MODE=
ACS_TRUSTED_TUNNEL_PROXY=
ACS_ALLOWED_TUNNEL_IDS=
ACS_TUNNEL_SCOPES=
ACS_ALLOW_UNSIGNED_TUNNEL_ID_DEV=

# Local config paths.
ACS_MCP_CONFIG=
ACS_MACHINE_CONTROLLER_CONFIG=

# Read-only ACP adapter.
ACS_ACP_AGENT_COMMAND=
ACS_ACP_AGENT_ARGS_JSON=[]
ACS_ACP_AGENT_CWD=
ACS_ACP_AGENT_ID=
ACS_ACP_ACTOR_ID=
ACS_ACP_INITIALIZE_TIMEOUT_MS=
ACS_ACP_PROTOCOL_VERSION=

# MoA/model routing.
ACS_MOA_CONFIG=
ACS_MOA_AUDIT_LOG=storage/moa-audit.jsonl
ACS_OPENROUTER_API_KEY=
ACS_OPENROUTER_BASE_URL=
ACS_OPENAI_API_KEY=
ACS_OPENAI_BASE_URL=
ACS_OLLAMA_BASE_URL=http://127.0.0.1:11434

# OpenAI Responses-compatible inference proxy. Disabled by default.
# When enabled, an explicit model allowlist is required; use `*` only intentionally.
ACS_INFERENCE_ENABLED=false
ACS_INFERENCE_ALLOWED_MODELS=
ACS_INFERENCE_AUDIT_LOG=storage/inference-audit.jsonl
ACS_INFERENCE_MAX_BODY_BYTES=16777216

# Pending-approval digest (optional ops log / local webhook). Default off.
# When enabled, a oneshot emits at most one JSON digest of needs_approval
# items older than N minutes (work item id + action hash only; no secrets).
# ACS_PENDING_APPROVAL_DIGEST_ENABLED=false
# ACS_PENDING_APPROVAL_DIGEST_OLDER_THAN_MINUTES=30
# ACS_PENDING_APPROVAL_DIGEST_STDOUT=true
# ACS_PENDING_APPROVAL_DIGEST_WEBHOOK_URL=
# ACS_PENDING_APPROVAL_DIGEST_ACTOR=ops-digest

# Visualizer portfolio intelligence (read-only MCP tools). Loopback only.
# Leave unset to keep portfolio.* tools advertised but returning PORTFOLIO_UNAVAILABLE.
# See docs/runbooks/portfolio-mcp.md
# ACS_PORTFOLIO_BASE_URL=http://127.0.0.1:8787
# ACS_PORTFOLIO_TIMEOUT_MS=5000
