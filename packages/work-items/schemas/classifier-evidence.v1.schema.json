{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-control-stack.local/schemas/classifier-evidence.v1.schema.json",
  "title": "ACS Classifier Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceId", "classifier", "subjectIntakeHash", "generatedAt", "taskType", "risk", "sensitivity", "authoritative"],
  "properties": {
    "schemaVersion": { "const": "acs.classifier-evidence.v1" },
    "evidenceId": { "type": "string", "minLength": 6, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "classifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "subjectIntakeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "taskType": { "$ref": "#/$defs/taskRecommendation" },
    "risk": { "$ref": "#/$defs/riskRecommendation" },
    "sensitivity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories", "signals"],
      "properties": {
        "categories": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "signals": { "$ref": "#/$defs/signals" }
      }
    },
    "authoritative": { "const": false }
  },
  "$defs": {
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId"],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
        "matchedTextHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "signals": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/signal" } },
    "taskRecommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendation", "signals"],
      "properties": {
        "recommendation": { "enum": ["coding", "research", "memory_lookup", "browser_scrape", "deal_analysis", "system_admin", "unknown"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "signals": { "$ref": "#/$defs/signals" }
      }
    },
    "riskRecommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendation", "signals"],
      "properties": {
        "recommendation": { "enum": ["read_only", "draft", "write", "destructive", "unknown"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "signals": { "$ref": "#/$defs/signals" }
      }
    }
  }
}
