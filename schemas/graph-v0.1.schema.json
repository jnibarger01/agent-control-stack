{
  "$id": "https://agent-control-stack.local/schemas/graph-v0.1.schema.json",
  "title": "ACS Graph Contract v0.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "graph_id": {
      "type": "string",
      "minLength": 7,
      "maxLength": 128,
      "pattern": "^graph_[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "version": {
      "type": "string",
      "const": "0.1"
    },
    "requested_by": {
      "type": "object",
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "actor_type": {
          "type": "string",
          "enum": ["human", "agent", "service", "system"]
        }
      },
      "required": ["actor_id", "actor_type"],
      "additionalProperties": false
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "nodes": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
          },
          "function_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
          },
          "dependencies": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
            }
          },
          "input": {
            "$ref": "#/$defs/__schema0"
          },
          "input_schema": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "output_schema": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "timeout": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400000
          },
          "retry_policy": {
            "type": "object",
            "properties": {
              "max_attempts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "backoff_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 86400000
              }
            },
            "required": ["max_attempts", "backoff_ms"],
            "additionalProperties": false
          },
          "risk": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "approval_required": {
            "type": "boolean"
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "required": {
            "type": "boolean"
          },
          "adapter": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
          },
          "inputs": {
            "maxItems": 256,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
                },
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
                },
                "cardinality": {
                  "type": "string",
                  "enum": ["ONE", "MANY"]
                },
                "required": {
                  "type": "boolean"
                }
              },
              "required": ["name", "type", "cardinality", "required"],
              "additionalProperties": false
            }
          },
          "outputs": {
            "maxItems": 256,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
                },
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
                }
              },
              "required": ["name", "type"],
              "additionalProperties": false
            }
          },
          "parameters": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema2"
            }
          },
          "evidenceRequirements": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
            }
          },
          "resources": {
            "type": "object",
            "properties": {
              "filesystem": {
                "maxItems": 256,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "scope": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024,
                      "pattern": "^[a-z][a-z0-9+.-]*:\\/\\/[A-Za-z0-9._~:@+-]+(?:\\/[A-Za-z0-9._~:@+-]+)*(?:\\/\\*\\*)?$"
                    },
                    "access": {
                      "type": "string",
                      "enum": ["READ", "WRITE"]
                    }
                  },
                  "required": ["scope", "access"],
                  "additionalProperties": false
                }
              },
              "gitWorktrees": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              },
              "ports": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "browserProfiles": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
                }
              },
              "services": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
                }
              },
              "externalTargets": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              }
            },
            "required": ["filesystem", "gitWorktrees", "ports", "browserProfiles", "services", "externalTargets"],
            "additionalProperties": false
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400000
          },
          "retry": {
            "type": "object",
            "properties": {
              "maxAttempts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              }
            },
            "required": ["maxAttempts"],
            "additionalProperties": false
          },
          "budget": {
            "type": "object",
            "properties": {
              "maxTokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "maxCostUsd": {
                "type": "number",
                "minimum": 0
              },
              "apiSlots": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": ["maxTokens", "maxCostUsd", "apiSlots"],
            "additionalProperties": false
          },
          "sideEffect": {
            "type": "string",
            "enum": ["NONE", "READ_ONLY", "WRITE", "EXTERNAL"]
          },
          "approval": {
            "type": "string",
            "enum": ["NONE", "HUMAN"]
          }
        },
        "required": [
          "id",
          "function_id",
          "dependencies",
          "input_schema",
          "output_schema",
          "timeout",
          "retry_policy",
          "risk",
          "approval_required",
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "schemaVersion": {
      "type": "string",
      "const": "0.1"
    },
    "graphId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "edges": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
          },
          "from": {
            "type": "object",
            "properties": {
              "nodeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
              },
              "port": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
              }
            },
            "required": ["nodeId", "port"],
            "additionalProperties": false
          },
          "to": {
            "type": "object",
            "properties": {
              "nodeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
              },
              "port": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
              }
            },
            "required": ["nodeId", "port"],
            "additionalProperties": false
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": ["id", "from", "to", "required"],
        "additionalProperties": false
      }
    },
    "acceptanceTests": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "required": {
            "type": "boolean"
          },
          "nodeIds": {
            "minItems": 1,
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
            }
          }
        },
        "required": ["id", "description", "required", "nodeIds"],
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxWorkers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "wallClockMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "tokenCeiling": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dollarCeilingUsd": {
          "type": "number",
          "minimum": 0
        },
        "apiConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "required": ["maxWorkers", "maxDepth", "wallClockMs", "tokenCeiling", "dollarCeilingUsd", "apiConcurrency"],
      "additionalProperties": false
    },
    "verdictPolicy": {
      "type": "object",
      "properties": {
        "requiredFailure": {
          "type": "string",
          "enum": ["FAIL", "PARTIAL"]
        },
        "optionalFailure": {
          "type": "string",
          "enum": ["IGNORE", "PARTIAL"]
        },
        "requiredCoverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": ["requiredFailure", "optionalFailure", "requiredCoverage"],
      "additionalProperties": false
    }
  },
  "required": ["graph_id", "version", "requested_by", "intent", "nodes", "risk", "idempotency_key", "correlation_id"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          }
        }
      ]
    },
    "__schema2": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema2"
          }
        }
      ]
    }
  }
}
