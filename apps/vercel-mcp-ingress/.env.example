# Public ingress auth mode: oauth (ChatGPT/plugins) or static_bearer.
ACS_VERCEL_PUBLIC_AUTH_MODE=oauth
ACS_VERCEL_QUEUE_REGION=iad1
ACS_VERCEL_MCP_TIMEOUT_MS=85000

# OAuth mode.
ACS_VERCEL_PUBLIC_RESOURCE_URL=https://YOUR_HOST/mcp
ACS_VERCEL_RESOURCE_METADATA_URL=https://YOUR_HOST/.well-known/oauth-protected-resource/mcp
ACS_VERCEL_OAUTH_ISSUER=https://YOUR_ISSUER
ACS_VERCEL_OAUTH_AUDIENCE=https://YOUR_HOST/mcp
ACS_VERCEL_OAUTH_JWKS_URI=https://YOUR_ISSUER/.well-known/jwks.json
ACS_VERCEL_OAUTH_AUTHORIZATION_SERVER=https://YOUR_ISSUER
ACS_VERCEL_OAUTH_SCOPES=acs:work:read,acs:work:create
ACS_VERCEL_BRIDGE_AUTH_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----...-----END PUBLIC KEY-----

# Static-bearer mode only.
# ACS_VERCEL_MCP_TOKEN=
