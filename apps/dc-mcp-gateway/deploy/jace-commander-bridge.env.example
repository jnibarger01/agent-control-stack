# ~/.config/desktop-commander-mcp-gateway/jc-bridge.env (0600) for
# jace-commander-mcp.service. No secrets are required by the bridge itself;
# JC_ACS_PUBLIC_KEY is PUBLIC verification material from ACS.
ACS_MANAGED_MODE=1

# Executor: leave JC_DC_DIR and DC_ARGS unset. bridge.js then runs the
# monorepo's own build (<repo>/vendor/desktop-commander/dist/jace-commander/cli.js,
# resolved relative to bridge.js); GET /authority reports runtime.monorepoDefault.
# Setting either one overrides that and can pin a stale checkout.
#JC_DC_DIR=
DC_CMD=/home/linuxbrew/.linuxbrew/bin/node

# Filesystem tools (list_directory, get_file_info, read_file, read_multiple_files)
# fail closed until roots are set. ':'-separated absolute paths. ACS must be
# given the same (or narrower) roots: ACS_JACE_COMMANDER_ALLOWED_ROOTS.
JC_FS_ROOTS=/home/jacen/projects
#JC_FS_DENIED_ROOTS=

# Required in managed mode (bridge refuses to start without them).
JC_ACS_PUBLIC_KEY=
JC_ACS_KEY_ID=
JC_RUNTIME_ID=jc-jacen-ubuntu

# Gateway identity attestation (same value as GATEWAY_EXECUTION_TOKEN in gateway.env).
DC_GATEWAY_EXECUTION_TOKEN=

# Optional pass-through to jace-commander (see docs/jace-commander.md in DC).
#JC_ACS_URL=http://127.0.0.1:3000
#JC_ACS_TOKEN=
#JC_SWARM_URL=http://127.0.0.1:9711
#JC_SWARM_TOKEN=
#JC_VISUALIZER_URL=http://127.0.0.1:<port>
#JC_STATE_DIR=
#JC_MISSION_ROUTER_DIR=
#JC_TRACE_ROOTS=

# Canonical JC result submission. Required: the bridge must report each governed
# call's terminal result so ACS can release the attempt-bound execution-admission
# permit. Use the dedicated acs-jc-bridge worker credential, never the DC bridge
# token.
#ACS_GATEWAY_URL=http://127.0.0.1:3000
#ACS_WORKER_TOKEN=

# --- Local preset (ADR 0026; see docs/jace-commander-local-preset.md) -------------------------
# Serve with JC's own policy instead of ACS capabilities. ACS_MANAGED_MODE is not required then.
#JC_PRESET=local
#JC_POLICY_PATH=/etc/jace-commander/policy.json        # must be unwritable by the JC account
# Human approval (public values only; printed by install-approverd.sh):
#JC_APPROVER_SOCKET=/run/jace-commander/request/request.sock
#JC_APPROVER_KEY_ID=jc-approver-1
#JC_APPROVER_PUBLIC_KEY=
# Run with no ACS at all (gateway side, valid only with JC_PRESET=local):
#JC_ACS_OPTIONAL=1
# Mirror the local trace to ACS (needs an ACS ingest route; leave unset until one exists):
#JC_ACS_MIRROR_URL=
