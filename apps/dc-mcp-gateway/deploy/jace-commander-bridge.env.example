# ~/.config/acs/jc-bridge.env (0600) for jace-commander-mcp.service (CachyOS user service).
# Install:  install -m 0600 jace-commander-bridge.env.example ~/.config/acs/jc-bridge.env
# Plain KEY=VALUE lines only: systemd's EnvironmentFile strips quotes and joins
# backslash continuations, so never put JSON or multi-line values here. Secrets
# that are not needed in the environment go in separate 0600 files (*_FILE).
# ~/.config/acs is masked from every JC workload by the sandbox.
#
# Set by the unit (deploy/systemd/jace-commander-mcp.service), not here:
#   BRIDGE_PROFILE, BRIDGE_PORT=8003, ACS_MANAGED_MODE=1, JC_PRESET=managed,
#   JC_WORKLOAD_ISOLATION=bwrap, JC_WORKLOAD_NETWORK=none,
#   JC_RUNTIME_DIR=%h/.local/lib/jace-commander/current, JC_REQUIRE_INSTALLED_RELEASE=1,
#   JC_ACS_AUTHORITY_TOKEN_FILE=%h/.config/acs/jc-authority.token
# Never set DC_ARGS or JC_DC_DIR here: the pinned bridge refuses DC_ARGS.

DC_CMD=/usr/bin/node
JC_SHELLS=/bin/bash

# Filesystem roots for file, process and git tools (':'-separated, absolute). They
# fail closed until set. ACS must be given the same (or narrower) roots:
# ACS_JACE_COMMANDER_ALLOWED_ROOTS.
JC_FS_ROOTS=/home/jacen/projects
# Optional split-root rollout: JC_FS_ROOTS=/home/jacen and
# JC_FS_WRITE_ROOTS=/home/jacen/projects; pair with ACS read/write roots.
# Split mode blocks start_process and privileged_exec until OS isolation exists.
#JC_FS_DENIED_ROOTS=

# ACS verification material (PUBLIC) and runtime identity. Required.
JC_ACS_PUBLIC_KEY=
JC_ACS_KEY_ID=
JC_RUNTIME_ID=jc-cachyos-x8664
JC_ACS_URL=http://127.0.0.1:3000

# Current-authority credential: NOT configured here. JC reads it only from
# JC_ACS_AUTHORITY_TOKEN_FILE (set by the unit): a dedicated ACS principal with
# role service and scope acs:read ONLY. JC_ACS_TOKEN and ACS_WORKER_TOKEN are
# never used for it; without the file every mutation fails closed and
# /jc/ready stays not ready.

# Required gateway identity attestation (same value as GATEWAY_EXECUTION_TOKEN in jc-edge.env).
DC_GATEWAY_EXECUTION_TOKEN=

# Required: canonical result submission with the dedicated acs-jc-bridge worker
# credential (never the DC bridge token, never the authority credential). ACS
# releases the execution-admission permit only when it receives each governed
# call's terminal result.
ACS_GATEWAY_URL=http://127.0.0.1:3000
ACS_WORKER_TOKEN=
ACS_WORKER_ID=acs-jc-bridge

# Optional: model-facing credential for the acs_read / acs_submit_mission tools only.
#JC_ACS_TOKEN=
#JC_PUBLIC_MCP_URL=https://cachyos-x8664.tailaa6d41.ts.net/jc/mcp

# --- Workload isolation (apps/jace-commander/src/sandbox.ts) --------------------
# host: shared network (npm install etc.); workloads can then reach host
# loopback services. Default (unit): none.
#JC_WORKLOAD_NETWORK=host
# Extra masked paths, e.g. an ACS data dir outside any checkout (':'-separated).
#JC_SANDBOX_HIDE=/home/jacen/ares-live/acs-live/storage
# Extra read-only paths (code that holds authority).
#JC_SANDBOX_READONLY=
# Extra writable paths besides JC_FS_ROOTS (caches).
#JC_SANDBOX_WRITABLE=/home/jacen/.cache:/home/jacen/.npm

# Optional integrations.
#JC_SWARM_URL=http://127.0.0.1:9711
#JC_SWARM_TOKEN=
#JC_VISUALIZER_URL=http://127.0.0.1:<port>
#JC_STATE_DIR=
#JC_MISSION_ROUTER_DIR=
#JC_TRACE_ROOTS=

# Managed deployment must not use local/standalone presets or ACS-optional routing.
