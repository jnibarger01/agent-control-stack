# Jace Commander MCP bridge (managed, ACS-authorized), hardened. Runs as jc-bridge.
# The bridge verifies gateway attestation and forwards capability-bearing calls to the EXECUTOR,
# which runs as jc-exec (a different uid, no secrets) via setpriv. The bridge refuses any tools/call
# without an ACS capability envelope before forwarding (bridge.js isUnauthorizedManagedToolCall).
#
# Credentials: /etc/jace-commander/bridge.env (root:jc-bridge 0640). It holds the attestation secret, the ACS
# worker token used for result reporting, and the ACS PUBLIC key. It never holds the gateway's ACS JC token.
[Unit]
Description=Jace Commander MCP bridge (managed, loopback)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jc-bridge
Group=jc-bridge
WorkingDirectory=/opt/agent-control-stack/apps/dc-mcp-gateway
EnvironmentFile=/etc/jace-commander/bridge.env
Environment=NODE_ENV=production
Environment=BRIDGE_PROFILE=jace-commander
Environment=BRIDGE_PORT=8003
Environment=ACS_MANAGED_MODE=1
Environment=JC_RUNTIME_ID=jc-managed
Environment=JC_STATE_DIR=/var/lib/jace-commander/bridge
Environment=DC_CMD=/usr/bin/setpriv
Environment="DC_ARGS=--reuid=jc-exec --regid=jc-exec --init-groups --inh-caps=-all --bounding-set=-all /usr/bin/node /opt/agent-control-stack/vendor/desktop-commander/dist/jace-commander/cli.js serve"
ExecStart=/usr/bin/node /opt/agent-control-stack/apps/dc-mcp-gateway/bridge.js
ExecStartPre=/usr/bin/test -s /etc/jace-commander/bridge.env
ExecStartPre=/usr/bin/test -r /opt/agent-control-stack/vendor/desktop-commander/dist/jace-commander/cli.js
Restart=on-failure
RestartSec=5

# --- sandbox -------------------------------------------------------------------------------------
# The bridge needs CAP_SETUID/CAP_SETGID only to drop the executor (setpriv) to jc-exec. Its own
# bounding set keeps nothing else; the executor's own capabilities are cleared by setpriv flags.
StateDirectory=jace-commander/bridge
StateDirectoryMode=0700
NoNewPrivileges=true
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_SETUID CAP_SETGID
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
# MemoryDenyWriteExecute is deliberately NOT set: V8 needs writable+executable pages for JIT.
SystemCallArchitectures=native
UMask=0077
# The executor is a child of this unit and inherits its mount namespace, so its state dir must be writable here.
ReadWritePaths=/var/lib/jace-commander/bridge /var/lib/jace-commander/exec
ReadOnlyPaths=/opt/agent-control-stack
# Loopback only for the bridge itself. PARITY COST: IPAddressDeny also applies to the executor, so git_fetch and
# git_push (remote network) will fail under this unit until an explicit host decision adds allowed git hosts.
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
