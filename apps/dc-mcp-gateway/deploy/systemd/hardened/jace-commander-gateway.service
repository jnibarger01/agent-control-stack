# Jace Commander OAuth gateway (authorization server + ACS capability REQUESTER), hardened.
# Runs as jc-gateway. Credentials: /etc/jace-commander/gateway.env (root:jc-gateway 0640). It never receives
# the bridge's ACS worker token or the executor's policy. Loopback only; the public edge proxies to it.
#
# Install (after migrate-jc-identities.sh --apply and preflight.sh pass):
#   cp jace-commander-gateway.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now jace-commander-gateway
[Unit]
Description=Jace Commander OAuth gateway (loopback)
After=network-online.target jace-commander-bridge.service
Wants=network-online.target jace-commander-bridge.service

[Service]
Type=simple
User=jc-gateway
Group=jc-gateway
WorkingDirectory=/opt/agent-control-stack/apps/dc-mcp-gateway
EnvironmentFile=/etc/jace-commander/gateway.env
Environment=NODE_ENV=production
Environment=DATA_DIR=/var/lib/jace-commander/gateway
Environment=GATEWAY_PORT=8010
ExecStart=/usr/bin/node /opt/agent-control-stack/apps/dc-mcp-gateway/server.js
Restart=on-failure
RestartSec=5
# Fail closed: refuse to start without the signing key, consent passphrase and attestation secret.
ExecStartPre=/usr/bin/test -s /etc/jace-commander/gateway.env
ExecStartPre=/usr/bin/test -d /var/lib/jace-commander/gateway

# --- sandbox -------------------------------------------------------------------------------------
StateDirectory=jace-commander/gateway
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateUsers=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
# MemoryDenyWriteExecute is deliberately NOT set: V8 needs writable+executable pages for JIT.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ReadWritePaths=/var/lib/jace-commander/gateway
ReadOnlyPaths=/opt/agent-control-stack/apps/dc-mcp-gateway
# Loopback (bridge, ACS over loopback) plus the configured ACS gateway address only.
IPAddressDeny=any
IPAddressAllow=localhost
# Set ACS_GATEWAY_URL to a loopback address, or add its address here explicitly.
# The gateway must not bind publicly: the public edge is the only ingress.

[Install]
WantedBy=multi-user.target
