[Unit]
Description=Agent Control Stack encrypted database backup
After=local-fs.target
# Retain/latest semantics: createManagedDatabaseBackup verifies the plaintext snapshot with
# PRAGMA integrity_check + foreign_key_check (full control-plane health) before encrypting and
# publishing a manifest. Older artifacts are pruned only after that gate. Plaintext alpha
# snapshots via scripts/sqlite-backup-restore.mjs snapshot similarly update destination-dir/latest.db
# only after the same integrity gate; a failed check leaves the previous good latest pointer in place.

[Service]
Type=oneshot
User=agent-control-stack
Group=agent-control-stack
EnvironmentFile=/etc/agent-control-stack/database-backup.env
WorkingDirectory=/opt/agent-control-stack
ExecStart=/usr/bin/npm run db:backup-policy -- backup ${ACS_DB_PATH} --destination ${ACS_BACKUP_DIRECTORY} --key-file ${ACS_BACKUP_KEY_FILE} --retain ${ACS_BACKUP_RETENTION_COUNT}
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/agent-control-stack
