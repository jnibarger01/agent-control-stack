# Vercel MCP bridge. File values must be regular owner-only (0600) files.
ACS_VERCEL_PROJECT=acs-mcp-ingress
# ACS_VERCEL_TEAM_ID=
ACS_VERCEL_QUEUE_REGION=iad1
ACS_VERCEL_ACCESS_TOKEN_FILE=/etc/agent-control-stack/vercel-access-token
ACS_VERCEL_LOCAL_MCP_URL=http://127.0.0.1:3000/mcp
ACS_VERCEL_REPLAY_DB=/opt/agent-control-stack/storage/vercel-bridge-replay.db
ACS_VERCEL_POLL_INTERVAL_MS=1000

# oauth: ChatGPT/plugin clients. tunnel: static-bearer/direct MCP clients.
ACS_VERCEL_AUTH_MODE=oauth

# OAuth mode only: X25519 private key; public half goes to Vercel.
ACS_VERCEL_AUTH_PRIVATE_KEY_FILE=/etc/agent-control-stack/vercel-bridge-auth-x25519.key

# Tunnel mode only.
# ACS_VERCEL_GATEWAY_TOKEN_FILE=/etc/agent-control-stack/gateway-service-token
# ACS_VERCEL_TUNNEL_PRIVATE_KEY_FILE=/etc/agent-control-stack/vercel-tunnel-ed25519.key
# ACS_VERCEL_CONNECTOR_ID=vercel-prod
# ACS_VERCEL_TUNNEL_ID=tunnel_vercel
# ACS_VERCEL_SESSION_ID=session_vercel
# ACS_VERCEL_HEARTBEAT_INTERVAL_MS=300000
