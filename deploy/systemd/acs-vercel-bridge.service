[Unit]
Description=Agent Control Stack Vercel MCP bridge
After=network-online.target
Wants=network-online.target
ConditionFileIsExecutable=/opt/agent-control-stack/runtime/node/bin/node

[Service]
Type=simple
User=agent-control-stack
Group=agent-control-stack
WorkingDirectory=/opt/agent-control-stack
EnvironmentFile=/etc/agent-control-stack/vercel-bridge.env
Environment=PATH=/opt/agent-control-stack/runtime/node/bin:/usr/bin
ExecStart=/usr/bin/env node /opt/agent-control-stack/apps/vercel-bridge-worker/dist/cli.js
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/agent-control-stack/storage
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
