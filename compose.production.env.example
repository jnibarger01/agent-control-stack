# agent-control-stack production compose env (template — copy, fill, never commit real values).
# Contract: docs/runbooks/production.md. OAuth trio REQUIRED for non-loopback OAuth mode.

# --- jace-auth production issuer (frozen; see jace-auth docs/ISSUER.md) ---
ACS_OAUTH_ISSUER=https://jace-auth.vercel.app
ACS_OAUTH_AUDIENCE=https://jace-auth.vercel.app/resources/agent-control-stack
ACS_OAUTH_JWKS_URI=https://jace-auth.vercel.app/jwks

# --- gateway credentials (secret store only) ---
# JSON array: [{"id":"operator-1","token":"<32+ chars>","actor":"operator","actorId":"operator-1","roles":["operator"],"scopes":["acs:read","acs:write","acs:approve"]}]
ACS_GATEWAY_CREDENTIALS_JSON=

# --- binding / origins ---
HOST=0.0.0.0
PORT=3000
ACS_MCP_ALLOWED_ORIGINS=https://your-gateway-host
ACS_DB_PATH=/data/control.db
